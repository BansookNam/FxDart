!**/ios/**/default.perspectivev3
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
.gstack/
coverage/

# Codecov uploader binary — downloaded on demand
codecov

# Working plans — local only
plans/

# Benchmark AOT binaries — rebuilt on demand by run_benchmarks.dart
benchmark/.build/

# The rendered site. Generated by tools/build_single_file.sh +
# tool/precompile_playgrounds.dart + tool/build_docs.dart, and published by
# .github/workflows/pages.yml straight to GitHub Pages — never committed.
#
# It was tracked until 0.8.7. Every change to lib/ rewrote ~1,900 of these
# files (a snippet's artifact id hashes the bundle), so any two branches that
# both touched lib/ conflicted on all of them, and none of those conflicts
# carried information. The sources are content/, i18n/, lib/ and web/.
/docs/
